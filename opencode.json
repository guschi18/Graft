{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.3-flash",
  "mcp": {
    "graft": {
      "type": "local",
      "command": [
        "graft",
        "mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "graft *": "allow",
      "npx graft *": "allow",
      "graft-dev *": "allow",
      "node dist/cli.js *": "allow",
      "node --version": "allow",
      "npm run *": "allow",
      "npm test": "allow",
      "npm install": "allow",
      "npx tsc *": "allow",
      "npx vitest *": "allow",
      "gh *": "allow",
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",
      "git show": "allow",
      "git branch": "allow",
      "git ls-files": "allow",
      "git check-ignore *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push": "allow",
      "git fetch": "allow",
      "git pull": "allow",
      "Get-ChildItem*": "allow",
      "Get-Content*": "allow",
      "sudo *": "deny",
      "chmod 777*": "deny"
    },
    "skill": {
      "*": "allow",
      "dotenv": "deny",
      "dotenvx": "deny"
    },
    "webfetch": "ask",
    "websearch": "allow",
    "external_directory": {
      "~/AppData/Local/Temp/opencode/**": "allow"
    }
  }
}
